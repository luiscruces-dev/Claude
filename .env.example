# Copia este archivo a ".env" y completa tus claves reales. Nunca subas ".env" al repo.

# Requerida: usada para convertir el cuento en un guion escena por escena.
ANTHROPIC_API_KEY=

# Requerida: usada para generar la narración en audio (voz del narrador).
ELEVENLABS_API_KEY=
# ID de la voz de ElevenLabs a usar como narrador (Voice Library o una voz clonada).
ELEVENLABS_VOICE_ID=

# Requerida: usada para generar los clips de video con Google Veo vía la API de Gemini.
GOOGLE_API_KEY=
# ID exacto del modelo Veo a usar. Verifica el valor actual en
# https://ai.google.dev/gemini-api/docs/video antes de correr el pipeline:
# el nombre del modelo cambia entre versiones (Veo 2, Veo 3, Veo 3.1, ...).
GOOGLE_VEO_MODEL=

# Opcional: sobreescribe los precios usados solo para la estimación de costo en el CLI.
VEO_PRICE_PER_SECOND_USD=0.40
ELEVENLABS_PRICE_PER_1K_CHARS_USD=0.10
